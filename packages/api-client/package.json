{
  "name": "@beauty/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Types of the API generated from its OpenAPI document (apps/api is the source)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@beauty/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
