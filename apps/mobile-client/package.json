{
  "name": "@beauty/mobile-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client app: my visits in every salon (Expo, iPhone and Android)",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --port 8081",
    "build": "expo export --platform android --platform ios --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "expo": "~58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@beauty/api-client": "workspace:*",
    "@beauty/config": "workspace:*",
    "@eslint/js": "^9.30.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
