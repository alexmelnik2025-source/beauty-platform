# Copy to .env: cp .env.example .env
# Values below are for local development only. Never reuse them in production.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://beauty:beauty_local_dev@127.0.0.1:5432/beauty?schema=public
TEST_DATABASE_URL=postgresql://beauty:beauty_local_dev@127.0.0.1:5432/beauty_test?schema=public

# Signs access tokens. Production: generate with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=local-development-only-secret-change-me-0123456789

# Emails go to Mailpit (docker compose) — open http://localhost:8025 to read them.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Beauty Platform <no-reply@localhost>
# Links in emails point here (the owner web app, task 5).
APP_WEB_URL=http://localhost:3000
# The web app (http://localhost:3000) passes /v1 on to the API: trust one proxy hop
# so rate limits see the visitor's address.
TRUST_PROXY=1
# Platform administrators (comma-separated emails): email queue page and alerts.
PLATFORM_ADMIN_EMAILS=

# Push messages to installed apps (Web Push). Local development only — production needs
# its own pair: node scripts/vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Codes by SMS: no gateway yet. log = the SMS text (with the code) goes to the API log.
# Local development only; production allows only none until a gateway is chosen.
SMS_TRANSPORT=log
