// Database schema. Connection settings live in prisma.config.ts.
// Conventions: UUIDv7 ids, snake_case tables/columns, timestamps in UTC (timestamptz).
// Spec: docs/README.md → MVP v3, section "Структура данных".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Explicit, so the client is the same everywhere: in Docker, install runs before tsconfig is copied.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// tr = Turkish, sq = Albanian (booking, client app and emails; the cabinet falls back to English).
enum Locale {
  pl
  uk
  ru
  en
  tr
  sq

  @@map("locale")
}

/// Languages a location or a staff member speaks with clients (shown on the booking page).
/// be = Belarusian. Not the same list as Locale (interface languages).
enum Language {
  pl
  uk
  ru
  be
  en

  @@map("language")
}

/// What a specialist does: the whole beauty trade, not only barbers. Shown to clients
/// next to the name; anything not on the list goes to StaffMember.customSpecialty.
enum Specialty {
  hairdresser
  barber
  nails
  cosmetologist
  brows_lashes
  makeup
  massage

  @@map("specialty")
}

enum MembershipRole {
  owner
  manager
  staff

  @@map("membership_role")
}

enum MembershipStatus {
  invited
  active

  @@map("membership_status")
}

enum ClientType {
  web
  mobile

  @@map("client_type")
}

enum AppointmentStatus {
  /// Slot reserved for 10 minutes while the client confirms by email code.
  held
  confirmed
  cancelled
  /// A hold that was never confirmed.
  expired
  completed
  no_show

  @@map("appointment_status")
}

enum AppointmentSource {
  online
  manual

  @@map("appointment_source")
}

enum CancelledBy {
  customer
  salon

  @@map("cancelled_by")
}

enum ConsentType {
  /// Acceptance of the booking terms (regulamin). Legal basis for the data: the contract.
  booking_terms
  /// Optional consent to marketing emails from the salon.
  marketing

  @@map("consent_type")
}

enum OutboxStatus {
  pending
  sent
  failed
  /// Not needed any more (e.g. reminder for a cancelled appointment).
  skipped

  @@map("outbox_status")
}

enum EmailTokenType {
  verify_email
  reset_password

  @@map("email_token_type")
}

/// A person who can sign in (owner, manager, staff). Salon customers are separate (task 4).
/// Loyalty program mechanics chosen by the salon (docs/LOYALTY.md).
/// stamps = cyclic stamp card, points = points balance exchanged for rewards.
enum LoyaltyMode {
  stamps
  points

  @@map("loyalty_mode")
}

/// Kinds of loyalty ledger entries. Entries are only ever added, never changed.
enum LoyaltyTransactionType {
  /// Stamps or points for a paid, completed visit.
  earn
  /// Takes back an earn (refund, visit marked "did not come").
  reverse
  /// Spent on a reward (task 10a, part 2).
  redeem
  /// Manual correction by the owner or manager (task 10a, part 2).
  adjust
  /// Points past their validity date (task 10f).
  expire

  @@map("loyalty_transaction_type")
}

/// What a client's tier is measured by (task 10e).
enum LoyaltyTierBasis {
  /// Paid visits in the period.
  visits
  /// What the client paid in the period (after coupons), in hundredths of the currency.
  spend

  @@map("loyalty_tier_basis")
}

/// What a reward from the salon's catalogue gives (task 10a, part 2).
enum LoyaltyRewardKind {
  /// A discount of discountPercent on a visit.
  discount_percent
  /// One service (freeServiceId) for free.
  free_service

  @@map("loyalty_reward_kind")
}

/// A coupon's state. "Expired" is not stored: an active coupon past expiresAt.
enum LoyaltyCouponStatus {
  active
  /// Applied to a visit (task 10d).
  used
  /// Withdrawn by the owner or manager; the stamps or points went back to the client.
  cancelled

  @@map("loyalty_coupon_status")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed.
  email           String    @unique
  /// E.164, for sign-in by phone. Taken from an accepted invitation or proven by an SMS code.
  phone           String?   @unique
  passwordHash    String    @map("password_hash")
  name            String
  locale          Locale    @default(pl)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       Membership[]
  staffMembers      StaffMember[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("app_user")
}

/// One signed-in device. The refresh token rotates on every use; reuse of an old one revokes the session.
model Session {
  id                       String     @id @default(uuid(7)) @db.Uuid
  userId                   String     @map("user_id") @db.Uuid
  clientType               ClientType @map("client_type")
  deviceName               String?    @map("device_name")
  userAgent                String?    @map("user_agent")
  refreshTokenHash         String     @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?    @unique @map("previous_refresh_token_hash")
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt               DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt                DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?  @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Single-use tokens sent by email (verification, password reset). Only the hash is stored.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_token")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nip       String?
  country   String   @default("PL") @db.Char(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  locations       Location[]
  auditLogs       AuditLog[]
  customers       Customer[]
  staffCategories StaffCategory[]
  invitations     Invitation[]
  notifications   Notification[]
  loyaltyProgram  LoyaltyProgram?

  @@map("organization")
}

/// A user's role in an organization. Managers and staff are limited to their locations.
model Membership {
  id                  String           @id @default(uuid(7)) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  role                MembershipRole
  status              MembershipStatus @default(active)
  /// Staff role only: the category whose permissions apply.
  staffCategoryId     String?          @map("staff_category_id") @db.Uuid
  /// Staff role only: personal exceptions, { "<permission>": true | false }.
  permissionOverrides Json             @default("{}") @map("permission_overrides")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffCategory StaffCategory?       @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  locations     MembershipLocation[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([staffCategoryId])
  @@map("membership")
}

/// An emailed invitation to join an organization as a manager or staff member.
/// Only the token hash is stored; accepting needs a signed-in user with the same verified email.
model Invitation {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  /// Lower-cased.
  email           String
  /// E.164, optional: the invited person can also sign in by this number.
  phone           String?
  role            MembershipRole
  locationIds     String[]       @map("location_ids") @db.Uuid
  /// Staff profile in the calendar that the new account takes over.
  staffMemberId   String?        @map("staff_member_id") @db.Uuid
  staffCategoryId String?        @map("staff_category_id") @db.Uuid
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([phone])
  @@map("invitation")
}

/// In-app notification for a salon user (new, cancelled, moved appointment).
/// Written in the same transaction as the change; push notifications (1.1) will read the same rows.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           String
  appointmentId  String?   @map("appointment_id") @db.Uuid
  /// What to show without another request: time, service, staff and client name. Never contacts.
  data           Json
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  /// When it was sent as a push message (null = not yet, or the user has no device for push).
  pushedAt       DateTime? @map("pushed_at") @db.Timestamptz(3)
  pushAttempts   Int       @default(0) @map("push_attempts")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

/// A browser or installed app that receives push messages (Web Push). One per device.
model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Address at the browser's push service; unique per device.
  endpoint      String    @unique
  /// Public key and auth secret of the device (base64url) — needed to encrypt messages.
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// A group of staff members with the same permissions ("Senior barber", "Trainee").
model StaffCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// { "<permission>": true | false }; a missing key falls back to the default.
  permissions    Json     @default("{}")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@map("staff_category")
}

model MembershipLocation {
  membershipId String @map("membership_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
  @@map("membership_location")
}

/// A salon / branch. Booking settings live here.
model Location {
  id                          String     @id @default(uuid(7)) @db.Uuid
  organizationId              String     @map("organization_id") @db.Uuid
  name                        String
  /// Public booking link: /b/<slug>
  slug                        String     @unique
  timezone                    String     @default("Europe/Warsaw")
  /// ISO 4217 code of the currency the salon prices its services in; amounts are in hundredths of it.
  currency                    String     @default("PLN") @db.Char(3)
  addressLine                 String     @map("address_line")
  city                        String
  postalCode                  String     @map("postal_code")
  latitude                    Float?
  longitude                   Float?
  phone                       String?
  email                       String?
  defaultLocale               Locale     @default(pl) @map("default_locale")
  slotStepMinutes             Int        @default(15) @map("slot_step_minutes")
  minLeadMinutes              Int        @default(60) @map("min_lead_minutes")
  bookingHorizonDays          Int        @default(30) @map("booking_horizon_days")
  clientCancelDeadlineMinutes Int        @default(120) @map("client_cancel_deadline_minutes")
  onlineBookingEnabled        Boolean    @default(false) @map("online_booking_enabled")
  /// Languages the salon speaks with clients, in the order chosen by the salon.
  languages                   Language[] @default([])
  /// Shown on the booking page under the salon name: what the salon is about.
  description                 String?
  /// Booking terms (regulamin) in Markdown, written by the salon. Required to switch online booking on.
  bookingTerms                String?    @map("booking_terms")
  /// Privacy policy in Markdown, written by the salon. Required to switch online booking on.
  privacyPolicy               String?    @map("privacy_policy")
  /// Optimistic locking: every update must send the version it read.
  version                     Int        @default(1)
  createdAt                   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships       MembershipLocation[]
  services          Service[]
  staffMembers      StaffMember[]
  appointments      Appointment[]
  happyHours        HappyHour[]
  timeBlocks        TimeBlock[]
  serviceCategories ServiceCategory[]
  photos            Photo[]

  @@index([organizationId])
  @@map("location")
}

/// A service of a location. Never deleted (appointments keep referring to it) — deactivated instead.
model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  /// Cleanup / preparation after the service; blocks the staff member but is not shown to clients.
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  /// Price in grosze (1 PLN = 100), never a float.
  priceGrosze     Int      @map("price_grosze")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  categoryId      String?  @map("category_id") @db.Uuid
  /// Calendar colour, "#RRGGBB".
  color           String?
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category     ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  appointments Appointment[]
  loyaltyRules LoyaltyEarnRule[]

  @@index([locationId])
  @@index([categoryId])
  @@map("service")
}

/// A group of services in the price list ("Haircuts", "Beard").
model ServiceCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([locationId, name])
  @@map("service_category")
}

/// A person who performs services at a location. May or may not have a user account.
model StaffMember {
  id              String      @id @default(uuid(7)) @db.Uuid
  locationId      String      @map("location_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  /// Shown to clients, e.g. "Kasia".
  displayName     String      @map("display_name")
  bio             String?
  /// Languages this staff member speaks with clients.
  languages       Language[]  @default([])
  /// What this specialist does, in the order the salon chose (task 11a, part 3).
  specialties     Specialty[] @default([])
  /// The salon's own words when the list has nothing that fits, e.g. "Trycholog".
  customSpecialty String?     @map("custom_specialty")
  active          Boolean     @default(true)
  sortOrder       Int         @default(0) @map("sort_order")
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     StaffService[]
  workingHours WorkingHours[]
  overrides    WorkingHoursOverride[]
  timeOff      TimeOff[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  photo        Photo?

  @@unique([locationId, userId])
  @@index([locationId])
  @@map("staff_member")
}

/// Photos for the booking page: the salon's gallery and one portrait per staff member.
/// Kept in the database (no paid file storage). Ids are random (UUIDv4): a photo is public to
/// anyone who has its link, like a picture on the salon's own website.
model Photo {
  id          String   @id @default(uuid()) @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  /// Set for a staff member's portrait (at most one each); null for the salon's photos.
  staffId     String?  @unique @map("staff_id") @db.Uuid
  /// image/jpeg, image/png or image/webp — taken from the file's first bytes, not from the upload.
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  location Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("photo")
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_service")
}

/// Weekly template in the location's local time. A break = two intervals on the same day.
model WorkingHours {
  id          String @id @default(uuid(7)) @db.Uuid
  staffId     String @map("staff_id") @db.Uuid
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int
  /// Minutes from local midnight, 0…1439.
  startMinute Int    @map("start_minute")
  /// Minutes from local midnight, 1…1440 (1440 = end of day).
  endMinute   Int    @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("working_hours")
}

/// Special hours for one local date; replace the weekly template on that date.
model WorkingHoursOverride {
  id          String   @id @default(uuid(7)) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  /// Local date at the location.
  date        DateTime @db.Date
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@map("working_hours_override")
}

/// Vacation, sick leave or blocked hours (UTC instants). Blocks slots in the period.
model TimeOff {
  id        String   @id @default(uuid(7)) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@map("time_off")
}

/// Time taken out of the calendar with a reason ("training", "lunch"): for one staff member
/// or, with no staff member, for the whole location. Never overlaps a live appointment.
/// Deleted blocks are kept (deletedAt) so calendars can learn about the deletion.
model TimeBlock {
  id              String    @id @default(uuid(7)) @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  staffId         String?   @map("staff_id") @db.Uuid
  startAt         DateTime  @map("start_at") @db.Timestamptz(3)
  endAt           DateTime  @map("end_at") @db.Timestamptz(3)
  reason          String?
  /// Blocks made together as "every week" share it (launch task L4); null = a single block.
  seriesId        String?   @map("series_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([locationId, startAt])
  @@index([staffId, startAt])
  @@index([locationId, updatedAt])
  @@index([seriesId])
  @@map("time_block")
}

/// Task 16: the salon's "happy hours" — a lower price on chosen weekdays and hours, for all or
/// some staff members and services. The best matching rule sets the price of a new visit.
model HappyHour {
  id              String   @id @default(uuid(7)) @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  /// ISO weekdays 1 (Monday) – 7 (Sunday).
  weekdays        Int[]
  /// Minutes after local midnight: a visit starting in [startMinute, endMinute) gets the price.
  startMinute     Int      @map("start_minute")
  endMinute       Int      @map("end_minute")
  discountPercent Int      @map("discount_percent")
  /// Empty = every staff member / every service of the location.
  staffIds        String[] @map("staff_ids") @db.Uuid
  serviceIds      String[] @map("service_ids") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("happy_hour")
}

/// A salon's client. Belongs to the organization; no login in the MVP (client accounts come in 2.0).
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// E.164, e.g. +48123456789.
  phone          String
  /// Lower-cased. Optional for bookings entered by the salon.
  email          String?
  locale         Locale   @default(pl)
  /// The salon's own note (preferences, allergies). Not shown to the client.
  note           String?
  /// Simple labels without any mailing ("regular", "short fade"). At most 10.
  tags           String[] @default([])
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  consents        ConsentRecord[]
  loyaltyAccounts LoyaltyAccount[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@index([email])
  @@map("customer")
}

/// What the client accepted or agreed to, with the text version and time (GDPR evidence).
model ConsentRecord {
  id         String      @id @default(uuid(7)) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       ConsentType
  version    String
  granted    Boolean
  ip         String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@map("consent_record")
}

/// A booking — or a 10-minute hold on a slot before the client confirms it.
/// No two held/confirmed rows of one staff member may overlap: enforced by the
/// exclusion constraint "appointment_no_overlap" (see the migration).
model Appointment {
  id                  String            @id @default(uuid(7)) @db.Uuid
  locationId          String            @map("location_id") @db.Uuid
  staffId             String            @map("staff_id") @db.Uuid
  serviceId           String            @map("service_id") @db.Uuid
  /// Empty while the slot is only held.
  customerId          String?           @map("customer_id") @db.Uuid
  status              AppointmentStatus
  source              AppointmentSource
  startAt             DateTime          @map("start_at") @db.Timestamptz(3)
  /// Start + service duration (what the client sees).
  endAt               DateTime          @map("end_at") @db.Timestamptz(3)
  /// End + buffer: until when the staff member is busy.
  blockedUntil        DateTime          @map("blocked_until") @db.Timestamptz(3)
  holdExpiresAt       DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  holdTokenHash       String?           @unique @map("hold_token_hash")
  /// Contact details entered during a hold, before the email is confirmed.
  holdContact         Json?             @map("hold_contact")
  /// Language of the client's emails.
  locale              Locale            @default(pl)
  /// The client picked this staff member (not "any staff member").
  staffChosenByClient Boolean           @default(false) @map("staff_chosen_by_client")
  /// Snapshot at booking time; later price changes do not affect it.
  priceGrosze         Int               @map("price_grosze")
  /// Task 10d: what the client's loyalty coupons take off the price (0 = none).
  /// The client pays priceGrosze - discountGrosze; loyalty is earned on that.
  discountGrosze      Int               @default(0) @map("discount_grosze")
  /// Task 10e: the part of discountGrosze that is the client's tier discount (0 = none), with
  /// the tier's name and percentage as they were when the staff used it.
  tierDiscountGrosze  Int               @default(0) @map("tier_discount_grosze")
  tierName            String?           @map("tier_name")
  tierDiscountPercent Int?              @map("tier_discount_percent")
  durationMinutes     Int               @map("duration_minutes")
  bufferMinutes       Int               @map("buffer_minutes")
  /// Task 16: the salon's happy-hour discount in priceGrosze (null = none): the service price
  /// before it and the percentage, as they were at booking time.
  listPriceGrosze     Int?              @map("list_price_grosze")
  happyHourPercent    Int?              @map("happy_hour_percent")
  note                String?
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy         CancelledBy?      @map("cancelled_by")
  cancelReason        String?           @map("cancel_reason")
  /// The staff confirmed the client paid (until payments exist, this mark is the
  /// "payment confirmed" that loyalty earning needs). Only on completed visits.
  paidAt              DateTime?         @map("paid_at") @db.Timestamptz(3)
  paidByUserId        String?           @map("paid_by_user_id") @db.Uuid
  createdByUserId     String?           @map("created_by_user_id") @db.Uuid
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  location         Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff            StaffMember              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer         Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events           AppointmentEvent[]
  verificationCode VerificationCode?
  accessTokens     AppointmentAccessToken[]
  loyaltyEntries   LoyaltyTransaction[]

  @@index([locationId, startAt])
  @@index([staffId, startAt])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@map("appointment")
}

/// Full history of an appointment: who changed what and when.
model AppointmentEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  type          String
  /// customer | staff | system
  actor         String
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_event")
}

/// The 6-digit email code that confirms a hold. Only the hash is stored.
model VerificationCode {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  email         String
  codeHash      String   @map("code_hash")
  /// Never later than the hold itself.
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  attempts      Int      @default(0)
  sendCount     Int      @default(1) @map("send_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("verification_code")
}

/// Secret link from the confirmation email to view, move or cancel the appointment.
model AppointmentAccessToken {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_access_token")
}

/// Emails waiting to be sent. Written in the same transaction as the change that
/// causes them, so a crash never loses a message; `dedupeKey` prevents doubles.
model NotificationOutbox {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(3)
  dedupeKey     String       @unique @map("dedupe_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

/// Stored responses for requests sent with an Idempotency-Key header: a retry after
/// a dropped connection gets the same answer instead of creating a duplicate.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  completed      Boolean  @default(false)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@map("idempotency_key")
}

/// Who did what. Never contains passwords or tokens.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

/// A client across all salons, identified by a confirmed email ("My visits" app).
/// Appointments are found through salon customer cards with the same email.
model Person {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Lower-cased; confirmed by a one-time code at every sign-in.
  email      String   @unique
  locale     Locale   @default(pl)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  sessions ClientSession[]

  @@map("person")
}

/// One-time 6-digit sign-in code for the client app. Only the hash is stored.
model ClientLoginCode {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// One active code per address: a new request replaces the previous code.
  email     String   @unique
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("client_login_code")
}

/// Passwordless sign-in for salon accounts (business app, owner-invited managers and staff).
/// One active code per address: a new request replaces the previous code. Only the hash is stored.
model StaffLoginCode {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// The account (or invitation) address; codes requested by phone are kept under it too.
  email     String   @unique
  /// Set when the code was requested by phone: sign-in then sends the phone, not the email.
  phone     String?  @unique
  /// True when the code went by SMS (proves the phone); false: by email (proves the address).
  bySms     Boolean  @default(false) @map("by_sms")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("staff_login_code")
}

/// A signed-in device of a client (web cookie or mobile token). Only the hash is stored.
model ClientSession {
  id         String     @id @default(uuid(7)) @db.Uuid
  personId   String     @map("person_id") @db.Uuid
  clientType ClientType @map("client_type")
  tokenHash  String     @unique @map("token_hash")
  userAgent  String?    @map("user_agent")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("client_session")
}

/// One loyalty program per salon (organization), set up by the owner or a manager.
/// The platform sets no rules: every number here is the salon's choice. See docs/LOYALTY.md.
model LoyaltyProgram {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @unique @map("organization_id") @db.Uuid
  enabled            Boolean          @default(false)
  mode               LoyaltyMode      @default(stamps)
  /// stamps mode: stamps for one paid visit (a service rule overrides it).
  stampsPerVisit     Int              @default(1) @map("stamps_per_visit")
  /// points mode: pointsPerUnit points for every full spendUnitGrosze spent
  /// (e.g. 10 points per 100 zł = 10 / 10000). A service rule overrides it.
  pointsPerUnit      Int              @default(0) @map("points_per_unit")
  spendUnitGrosze    Int              @default(10000) @map("spend_unit_grosze")
  /// Visits cheaper than this earn nothing.
  minSpendGrosze     Int              @default(0) @map("min_spend_grosze")
  /// points mode: points expire this many days after they were earned; null = never.
  pointsValidityDays Int?             @map("points_validity_days")
  /// Rewards may never take more than this share of a visit's price (task 10d).
  maxDiscountPercent Int              @default(100) @map("max_discount_percent")
  /// Several discounts on one visit (task 10d).
  allowStacking      Boolean          @default(false) @map("allow_stacking")
  /// The salon agrees to take part in the marketplace (only a flag until it exists, task 10g).
  marketplaceEnabled Boolean          @default(false) @map("marketplace_enabled")
  /// Task 10e: tiers are reached by paid visits or by spend over the last tierPeriodDays.
  tierBasis          LoyaltyTierBasis @default(visits) @map("tier_basis")
  tierPeriodDays     Int              @default(365) @map("tier_period_days")
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  earnRules    LoyaltyEarnRule[]
  accounts     LoyaltyAccount[]
  rewards      LoyaltyReward[]
  tiers        LoyaltyTier[]
  bonusRules   LoyaltyBonusRule[]

  @@map("loyalty_program")
}

/// A fixed number of stamps or points for one service, instead of the program's general rule.
/// 0 = the service earns nothing.
model LoyaltyEarnRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  points    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([programId, serviceId])
  @@index([serviceId])
  @@map("loyalty_earn_rule")
}

/// A client's balance in one salon's program: stamps of the current cycle or points.
/// Never below zero (CHECK constraint "loyalty_account_balance_not_negative").
model LoyaltyAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0) @map("lifetime_earned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  program      LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  coupons      LoyaltyCoupon[]

  @@unique([programId, customerId])
  @@index([customerId])
  @@map("loyalty_account")
}

/// The ledger: every change of a balance, added and never edited.
model LoyaltyTransaction {
  id            String                 @id @default(uuid(7)) @db.Uuid
  accountId     String                 @map("account_id") @db.Uuid
  type          LoyaltyTransactionType
  /// Signed: + earned, − taken back or spent.
  points        Int
  balanceAfter  Int                    @map("balance_after")
  appointmentId String?                @map("appointment_id") @db.Uuid
  /// reverse: the entry it takes back (each entry can be taken back once).
  reversesId    String?                @unique @map("reverses_id") @db.Uuid
  /// Guards against doing the same thing twice, e.g. "earn:<appointment>:<n>".
  dedupeKey     String                 @unique @map("dedupe_key")
  expiresAt     DateTime?              @map("expires_at") @db.Timestamptz(3)
  actorUserId   String?                @map("actor_user_id") @db.Uuid
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  account     LoyaltyAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reverses    LoyaltyTransaction? @relation("LoyaltyReversal", fields: [reversesId], references: [id], onDelete: NoAction)
  reversedBy  LoyaltyTransaction? @relation("LoyaltyReversal")
  coupon      LoyaltyCoupon?

  @@index([accountId, createdAt])
  @@index([appointmentId])
  @@map("loyalty_transaction")
}

/// Task 10e: the salon's own client tiers (e.g. Standard / Silver / Gold / VIP): reached at a
/// threshold of visits or spend (the program's tierBasis) and giving their own discount.
model LoyaltyTier {
  id              String   @id @default(uuid(7)) @db.Uuid
  programId       String   @map("program_id") @db.Uuid
  name            String
  /// Visits or hundredths of the currency, by the program's tierBasis; 0 = everyone.
  threshold       Int
  discountPercent Int      @default(0) @map("discount_percent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, threshold])
  @@map("loyalty_tier")
}

/// Task 19: extra stamps or points the salon gives at chosen specialists and/or on chosen
/// weekdays (e.g. ×2 on Monday–Wednesday at one barber). The paid visit earns
/// base × multiplier + extraPoints by the best matching rule; nothing extra when the visit
/// itself earns nothing (below the minimum, or a service rule of 0).
model LoyaltyBonusRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  name        String
  /// Specialists the rule is for; empty = every specialist.
  staffIds    String[] @default([]) @map("staff_ids") @db.Uuid
  /// ISO weekdays of the visit in the salon's time zone (1 = Monday … 7 = Sunday); empty = every day.
  weekdays    Int[]    @default([])
  multiplier  Int      @default(1)
  extraPoints Int      @default(0) @map("extra_points")
  /// Only when the client's previous paid visit at the salon was at most this many days
  /// before (e.g. 21 = "comes every 3 weeks"); null = any visit.
  withinDays  Int?     @map("within_days")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("loyalty_bonus_rule")
}

/// The salon's catalogue of rewards: what a client can take for stamps or points.
/// Removing a reward only archives it: coupons already taken stay valid.
/// The kind and its fields must agree (CHECK constraint "loyalty_reward_kind_fields").
model LoyaltyReward {
  id                 String            @id @default(uuid(7)) @db.Uuid
  programId          String            @map("program_id") @db.Uuid
  name               String
  kind               LoyaltyRewardKind
  /// discount_percent: 1–100.
  discountPercent    Int?              @map("discount_percent")
  /// free_service: the service given for free (a service of the salon).
  freeServiceId      String?           @map("free_service_id") @db.Uuid
  /// Stamps or points the reward costs. Stamps: the stamps needed in the current cycle.
  cost               Int
  /// The coupon is valid only for these services; empty = any service.
  serviceIds         String[]          @default([]) @map("service_ids") @db.Uuid
  /// The coupon is valid this many days after it was taken; null = no limit.
  couponValidityDays Int?              @map("coupon_validity_days")
  sortOrder          Int               @default(0) @map("sort_order")
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(3)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  program LoyaltyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  coupons LoyaltyCoupon[]

  @@index([programId])
  @@map("loyalty_reward")
}

/// A reward a client has taken: stamps or points were spent (the "redeem" ledger entry).
/// Keeps a copy of the reward's terms, so later changes of the catalogue do not change it.
model LoyaltyCoupon {
  id                  String              @id @default(uuid(7)) @db.Uuid
  accountId           String              @map("account_id") @db.Uuid
  rewardId            String              @map("reward_id") @db.Uuid
  /// Short code the client shows at the salon.
  code                String              @unique
  status              LoyaltyCouponStatus @default(active)
  name                String
  kind                LoyaltyRewardKind
  discountPercent     Int?                @map("discount_percent")
  freeServiceId       String?             @map("free_service_id") @db.Uuid
  serviceIds          String[]            @default([]) @map("service_ids") @db.Uuid
  /// What the client paid for it (stamps or points).
  cost                Int
  /// The "redeem" ledger entry; cancelling adds a "reverse" of it.
  redeemTransactionId String              @unique @map("redeem_transaction_id") @db.Uuid
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(3)
  /// Task 10d: the visit it was used on.
  usedAppointmentId   String?             @map("used_appointment_id") @db.Uuid
  usedAt              DateTime?           @map("used_at") @db.Timestamptz(3)
  /// What it took off that visit's price.
  discountGrosze      Int?                @map("discount_grosze")
  cancelledAt         DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId   String?             @map("cancelled_by_user_id") @db.Uuid
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  account           LoyaltyAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward            LoyaltyReward      @relation(fields: [rewardId], references: [id], onDelete: NoAction)
  redeemTransaction LoyaltyTransaction @relation(fields: [redeemTransactionId], references: [id], onDelete: NoAction)

  @@index([accountId, status])
  @@index([rewardId])
  @@index([usedAppointmentId])
  @@map("loyalty_coupon")
}
