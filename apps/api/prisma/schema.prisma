// Database schema. Connection settings live in prisma.config.ts.
// Conventions: UUIDv7 ids, snake_case tables/columns, timestamps in UTC (timestamptz).
// Spec: docs/README.md → MVP v3, section "Структура данных".

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  pl
  uk
  ru
  en

  @@map("locale")
}

enum MembershipRole {
  owner
  manager
  staff

  @@map("membership_role")
}

enum MembershipStatus {
  invited
  active

  @@map("membership_status")
}

enum ClientType {
  web
  mobile

  @@map("client_type")
}

enum AppointmentStatus {
  /// Slot reserved for 10 minutes while the client confirms by email code.
  held
  confirmed
  cancelled
  /// A hold that was never confirmed.
  expired
  completed
  no_show

  @@map("appointment_status")
}

enum AppointmentSource {
  online
  manual

  @@map("appointment_source")
}

enum CancelledBy {
  customer
  salon

  @@map("cancelled_by")
}

enum ConsentType {
  /// Acceptance of the booking terms (regulamin). Legal basis for the data: the contract.
  booking_terms
  /// Optional consent to marketing emails from the salon.
  marketing

  @@map("consent_type")
}

enum OutboxStatus {
  pending
  sent
  failed
  /// Not needed any more (e.g. reminder for a cancelled appointment).
  skipped

  @@map("outbox_status")
}

enum EmailTokenType {
  verify_email
  reset_password

  @@map("email_token_type")
}

/// A person who can sign in (owner, manager, staff). Salon customers are separate (task 4).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed.
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  locale          Locale    @default(pl)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  emailTokens   EmailToken[]
  memberships   Membership[]
  staffMembers      StaffMember[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("app_user")
}

/// One signed-in device. The refresh token rotates on every use; reuse of an old one revokes the session.
model Session {
  id                       String     @id @default(uuid(7)) @db.Uuid
  userId                   String     @map("user_id") @db.Uuid
  clientType               ClientType @map("client_type")
  deviceName               String?    @map("device_name")
  userAgent                String?    @map("user_agent")
  refreshTokenHash         String     @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?    @unique @map("previous_refresh_token_hash")
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt               DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt                DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?  @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Single-use tokens sent by email (verification, password reset). Only the hash is stored.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_token")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  nip       String?
  country   String   @default("PL") @db.Char(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  locations       Location[]
  auditLogs       AuditLog[]
  customers       Customer[]
  staffCategories StaffCategory[]
  invitations     Invitation[]
  notifications   Notification[]

  @@map("organization")
}

/// A user's role in an organization. Managers and staff are limited to their locations.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// Staff role only: the category whose permissions apply.
  staffCategoryId String?          @map("staff_category_id") @db.Uuid
  /// Staff role only: personal exceptions, { "<permission>": true | false }.
  permissionOverrides Json         @default("{}") @map("permission_overrides")
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffCategory StaffCategory?       @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  locations     MembershipLocation[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([staffCategoryId])
  @@map("membership")
}

/// An emailed invitation to join an organization as a manager or staff member.
/// Only the token hash is stored; accepting needs a signed-in user with the same verified email.
model Invitation {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  /// Lower-cased.
  email           String
  role            MembershipRole
  locationIds     String[]       @map("location_ids") @db.Uuid
  /// Staff profile in the calendar that the new account takes over.
  staffMemberId   String?        @map("staff_member_id") @db.Uuid
  staffCategoryId String?        @map("staff_category_id") @db.Uuid
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitation")
}

/// In-app notification for a salon user (new, cancelled, moved appointment).
/// Written in the same transaction as the change; push notifications (1.1) will read the same rows.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           String
  appointmentId  String?   @map("appointment_id") @db.Uuid
  /// What to show without another request: time, service, staff and client name. Never contacts.
  data           Json
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  /// When it was sent as a push message (null = not yet, or the user has no device for push).
  pushedAt       DateTime? @map("pushed_at") @db.Timestamptz(3)
  pushAttempts   Int       @default(0) @map("push_attempts")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

/// A browser or installed app that receives push messages (Web Push). One per device.
model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Address at the browser's push service; unique per device.
  endpoint      String    @unique
  /// Public key and auth secret of the device (base64url) — needed to encrypt messages.
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// A group of staff members with the same permissions ("Senior barber", "Trainee").
model StaffCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// { "<permission>": true | false }; a missing key falls back to the default.
  permissions    Json     @default("{}")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@map("staff_category")
}

model MembershipLocation {
  membershipId String @map("membership_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
  @@map("membership_location")
}

/// A salon / branch. Booking settings live here.
model Location {
  id                          String   @id @default(uuid(7)) @db.Uuid
  organizationId              String   @map("organization_id") @db.Uuid
  name                        String
  /// Public booking link: /b/<slug>
  slug                        String   @unique
  timezone                    String   @default("Europe/Warsaw")
  addressLine                 String   @map("address_line")
  city                        String
  postalCode                  String   @map("postal_code")
  phone                       String?
  email                       String?
  defaultLocale               Locale   @default(pl) @map("default_locale")
  slotStepMinutes             Int      @default(15) @map("slot_step_minutes")
  minLeadMinutes              Int      @default(60) @map("min_lead_minutes")
  bookingHorizonDays          Int      @default(30) @map("booking_horizon_days")
  clientCancelDeadlineMinutes Int      @default(120) @map("client_cancel_deadline_minutes")
  onlineBookingEnabled        Boolean  @default(false) @map("online_booking_enabled")
  /// Optimistic locking: every update must send the version it read.
  version                     Int      @default(1)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships       MembershipLocation[]
  services          Service[]
  staffMembers      StaffMember[]
  appointments      Appointment[]
  timeBlocks        TimeBlock[]
  serviceCategories ServiceCategory[]

  @@index([organizationId])
  @@map("location")
}

/// A service of a location. Never deleted (appointments keep referring to it) — deactivated instead.
model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  /// Cleanup / preparation after the service; blocks the staff member but is not shown to clients.
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  /// Price in grosze (1 PLN = 100), never a float.
  priceGrosze     Int      @map("price_grosze")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  categoryId      String?  @map("category_id") @db.Uuid
  /// Calendar colour, "#RRGGBB".
  color           String?
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  appointments Appointment[]

  @@index([locationId])
  @@index([categoryId])
  @@map("service")
}

/// A group of services in the price list ("Haircuts", "Beard").
model ServiceCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([locationId, name])
  @@map("service_category")
}

/// A person who performs services at a location. May or may not have a user account.
model StaffMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  /// Shown to clients, e.g. "Kasia".
  displayName String   @map("display_name")
  bio         String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     StaffService[]
  workingHours WorkingHours[]
  overrides    WorkingHoursOverride[]
  timeOff      TimeOff[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]

  @@unique([locationId, userId])
  @@index([locationId])
  @@map("staff_member")
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_service")
}

/// Weekly template in the location's local time. A break = two intervals on the same day.
model WorkingHours {
  id          String @id @default(uuid(7)) @db.Uuid
  staffId     String @map("staff_id") @db.Uuid
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int
  /// Minutes from local midnight, 0…1439.
  startMinute Int    @map("start_minute")
  /// Minutes from local midnight, 1…1440 (1440 = end of day).
  endMinute   Int    @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("working_hours")
}

/// Special hours for one local date; replace the weekly template on that date.
model WorkingHoursOverride {
  id          String   @id @default(uuid(7)) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  /// Local date at the location.
  date        DateTime @db.Date
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@map("working_hours_override")
}

/// Vacation, sick leave or blocked hours (UTC instants). Blocks slots in the period.
model TimeOff {
  id        String   @id @default(uuid(7)) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@map("time_off")
}

/// Time taken out of the calendar with a reason ("training", "lunch"): for one staff member
/// or, with no staff member, for the whole location. Never overlaps a live appointment.
/// Deleted blocks are kept (deletedAt) so calendars can learn about the deletion.
model TimeBlock {
  id              String    @id @default(uuid(7)) @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  staffId         String?   @map("staff_id") @db.Uuid
  startAt         DateTime  @map("start_at") @db.Timestamptz(3)
  endAt           DateTime  @map("end_at") @db.Timestamptz(3)
  reason          String?
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([locationId, startAt])
  @@index([staffId, startAt])
  @@index([locationId, updatedAt])
  @@map("time_block")
}

/// A salon's client. Belongs to the organization; no login in the MVP (client accounts come in 2.0).
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// E.164, e.g. +48123456789.
  phone          String
  /// Lower-cased. Optional for bookings entered by the salon.
  email          String?
  locale         Locale   @default(pl)
  /// The salon's own note (preferences, allergies). Not shown to the client.
  note           String?
  /// Simple labels without any mailing ("regular", "short fade"). At most 10.
  tags           String[] @default([])
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  consents     ConsentRecord[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@map("customer")
}

/// What the client accepted or agreed to, with the text version and time (GDPR evidence).
model ConsentRecord {
  id         String      @id @default(uuid(7)) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       ConsentType
  version    String
  granted    Boolean
  ip         String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@map("consent_record")
}

/// A booking — or a 10-minute hold on a slot before the client confirms it.
/// No two held/confirmed rows of one staff member may overlap: enforced by the
/// exclusion constraint "appointment_no_overlap" (see the migration).
model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  locationId      String            @map("location_id") @db.Uuid
  staffId         String            @map("staff_id") @db.Uuid
  serviceId       String            @map("service_id") @db.Uuid
  /// Empty while the slot is only held.
  customerId      String?           @map("customer_id") @db.Uuid
  status          AppointmentStatus
  source          AppointmentSource
  startAt         DateTime          @map("start_at") @db.Timestamptz(3)
  /// Start + service duration (what the client sees).
  endAt           DateTime          @map("end_at") @db.Timestamptz(3)
  /// End + buffer: until when the staff member is busy.
  blockedUntil    DateTime          @map("blocked_until") @db.Timestamptz(3)
  holdExpiresAt   DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  holdTokenHash   String?           @unique @map("hold_token_hash")
  /// Contact details entered during a hold, before the email is confirmed.
  holdContact     Json?             @map("hold_contact")
  /// Language of the client's emails.
  locale          Locale            @default(pl)
  /// The client picked this staff member (not "any staff member").
  staffChosenByClient Boolean       @default(false) @map("staff_chosen_by_client")
  /// Snapshot at booking time; later price changes do not affect it.
  priceGrosze     Int               @map("price_grosze")
  durationMinutes Int               @map("duration_minutes")
  bufferMinutes   Int               @map("buffer_minutes")
  note            String?
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     CancelledBy?      @map("cancelled_by")
  cancelReason    String?           @map("cancel_reason")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  location         Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff            StaffMember              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer         Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events           AppointmentEvent[]
  verificationCode VerificationCode?
  accessTokens     AppointmentAccessToken[]

  @@index([locationId, startAt])
  @@index([staffId, startAt])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@map("appointment")
}

/// Full history of an appointment: who changed what and when.
model AppointmentEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  type          String
  /// customer | staff | system
  actor         String
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_event")
}

/// The 6-digit email code that confirms a hold. Only the hash is stored.
model VerificationCode {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  email         String
  codeHash      String   @map("code_hash")
  /// Never later than the hold itself.
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  attempts      Int      @default(0)
  sendCount     Int      @default(1) @map("send_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("verification_code")
}

/// Secret link from the confirmation email to view, move or cancel the appointment.
model AppointmentAccessToken {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_access_token")
}

/// Emails waiting to be sent. Written in the same transaction as the change that
/// causes them, so a crash never loses a message; `dedupeKey` prevents doubles.
model NotificationOutbox {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(3)
  dedupeKey     String       @unique @map("dedupe_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

/// Stored responses for requests sent with an Idempotency-Key header: a retry after
/// a dropped connection gets the same answer instead of creating a duplicate.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  completed      Boolean  @default(false)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@map("idempotency_key")
}

/// Who did what. Never contains passwords or tokens.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}
