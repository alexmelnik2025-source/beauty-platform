# Copy to .env on the EU host, then replace every placeholder before starting.
# These values are examples only; do not commit the filled-in .env file.
POSTGRES_DB=beauty
POSTGRES_USER=beauty
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Bind the web app to loopback; terminate HTTPS with your host reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
APP_WEB_URL=https://beauty.example.invalid

# Configure an SMTP server you control. No provider is selected or provisioned here.
SMTP_URL=smtp://user:password@smtp.example.invalid:587
MAIL_FROM="Beauty Platform <no-reply@example.invalid>"
PLATFORM_ADMIN_EMAILS=admin@example.invalid

# Leave both empty to keep Web Push off until you generate a key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
TRUST_PROXY=1
